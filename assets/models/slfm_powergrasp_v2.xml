<mujoco model="spider_hand_powergrasp_v2">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <default>
    <joint damping="1.0" armature="0.05"/>
    <geom friction="1.2 0.005 0.0001" condim="3"/>
  </default>
  <worldbody>
    <light diffuse="0.5 0.5 0.5" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"/>
    
    <body name="cylinder" pos="0 0 0.04">
      <freejoint name="cylinder_root"/>
      <geom name="cylinder_geom" type="cylinder" size="0.015 0.04" mass="0.5" rgba="0.2 0.6 0.8 1"/>
    </body>
    
    <body name="palm" pos="0 0 0.10">
      <geom name="palm_geom" type="box" size="0.03 0.04 0.01" rgba="0.5 0.4 0.3 1"/>
      
      <body name="thumb" pos="-0.02 -0.035 0" euler="0 0 -60">
        <joint name="thumb_coxa" type="hinge" axis="0 0 1" range="-30 30"/>
        <geom type="capsule" size="0.004" fromto="0 0 0 0.012 0 -0.003"/>
        <body name="thumb_femur" pos="0.012 0 -0.003">
          <joint name="thumb_femur" type="hinge" axis="0 1 0" range="0 120"/>
          <geom type="capsule" size="0.004" fromto="0 0 0 0.03 0 0"/>
          <body name="thumb_tibia" pos="0.03 0 0">
            <joint name="thumb_tibia" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.003" fromto="0 0 0 0.035 0 0"/>
            <site name="thumb_tip" pos="0.035 0 0" size="0.004" type="sphere"/>
          </body>
        </body>
      </body>
      
      <body name="index" pos="0.025 -0.02 0" euler="0 0 -20">
        <joint name="index_coxa" type="hinge" axis="0 0 1" range="-30 30"/>
        <geom type="capsule" size="0.004" fromto="0 0 0 0.012 0 -0.003"/>
        <body name="index_femur" pos="0.012 0 -0.003">
          <joint name="index_femur" type="hinge" axis="0 1 0" range="0 120"/>
          <geom type="capsule" size="0.004" fromto="0 0 0 0.035 0 0"/>
          <body name="index_tibia" pos="0.035 0 0">
            <joint name="index_tibia" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.003" fromto="0 0 0 0.04 0 0"/>
            <site name="index_tip" pos="0.04 0 0" size="0.004" type="sphere"/>
          </body>
        </body>
      </body>
      
      <body name="middle" pos="0.028 0 0" euler="0 0 0">
        <joint name="middle_coxa" type="hinge" axis="0 0 1" range="-30 30"/>
        <geom type="capsule" size="0.004" fromto="0 0 0 0.012 0 -0.003"/>
        <body name="middle_femur" pos="0.012 0 -0.003">
          <joint name="middle_femur" type="hinge" axis="0 1 0" range="0 120"/>
          <geom type="capsule" size="0.004" fromto="0 0 0 0.037 0 0"/>
          <body name="middle_tibia" pos="0.037 0 0">
            <joint name="middle_tibia" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.003" fromto="0 0 0 0.042 0 0"/>
            <site name="middle_tip" pos="0.042 0 0" size="0.004" type="sphere"/>
          </body>
        </body>
      </body>
      
      <body name="ring" pos="0.025 0.02 0" euler="0 0 20">
        <joint name="ring_coxa" type="hinge" axis="0 0 1" range="-30 30"/>
        <geom type="capsule" size="0.004" fromto="0 0 0 0.012 0 -0.003"/>
        <body name="ring_femur" pos="0.012 0 -0.003">
          <joint name="ring_femur" type="hinge" axis="0 1 0" range="0 120"/>
          <geom type="capsule" size="0.004" fromto="0 0 0 0.033 0 0"/>
          <body name="ring_tibia" pos="0.033 0 0">
            <joint name="ring_tibia" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.003" fromto="0 0 0 0.038 0 0"/>
            <site name="ring_tip" pos="0.038 0 0" size="0.004" type="sphere"/>
          </body>
        </body>
      </body>
      
      <body name="pinky" pos="0.02 0.035 0" euler="0 0 40">
        <joint name="pinky_coxa" type="hinge" axis="0 0 1" range="-30 30"/>
        <geom type="capsule" size="0.004" fromto="0 0 0 0.01 0 -0.003"/>
        <body name="pinky_femur" pos="0.01 0 -0.003">
          <joint name="pinky_femur" type="hinge" axis="0 1 0" range="0 120"/>
          <geom type="capsule" size="0.004" fromto="0 0 0 0.028 0 0"/>
          <body name="pinky_tibia" pos="0.028 0 0">
            <joint name="pinky_tibia" type="hinge" axis="0 1 0" range="0 150"/>
            <geom type="capsule" size="0.003" fromto="0 0 0 0.032 0 0"/>
            <site name="pinky_tip" pos="0.032 0 0" size="0.004" type="sphere"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="thumb_coxa_act" joint="thumb_coxa" kp="30" kv="3"/>
    <position name="thumb_femur_act" joint="thumb_femur" kp="50" kv="5"/>
    <position name="thumb_tibia_act" joint="thumb_tibia" kp="80" kv="8"/>
    <position name="index_coxa_act" joint="index_coxa" kp="30" kv="3"/>
    <position name="index_femur_act" joint="index_femur" kp="50" kv="5"/>
    <position name="index_tibia_act" joint="index_tibia" kp="80" kv="8"/>
    <position name="middle_coxa_act" joint="middle_coxa" kp="30" kv="3"/>
    <position name="middle_femur_act" joint="middle_femur" kp="50" kv="5"/>
    <position name="middle_tibia_act" joint="middle_tibia" kp="80" kv="8"/>
    <position name="ring_coxa_act" joint="ring_coxa" kp="30" kv="3"/>
    <position name="ring_femur_act" joint="ring_femur" kp="50" kv="5"/>
    <position name="ring_tibia_act" joint="ring_tibia" kp="80" kv="8"/>
    <position name="pinky_coxa_act" joint="pinky_coxa" kp="30" kv="3"/>
    <position name="pinky_femur_act" joint="pinky_femur" kp="50" kv="5"/>
    <position name="pinky_tibia_act" joint="pinky_tibia" kp="80" kv="8"/>
  </actuator>
  <sensor>
    <touch name="thumb_touch" site="thumb_tip"/>
    <touch name="index_touch" site="index_tip"/>
    <touch name="middle_touch" site="middle_tip"/>
    <touch name="ring_touch" site="ring_tip"/>
    <touch name="pinky_touch" site="pinky_tip"/>
  </sensor>
</mujoco>